<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StorageVisualiser.App.ViewModels"
        xmlns:controls="using:StorageVisualiser.App.Controls"
        xmlns:core="using:StorageVisualiser.Core.Model"
        xmlns:analysis="using:StorageVisualiser.Core.Analysis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1260" d:DesignHeight="800"
        x:Class="StorageVisualiser.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Storage Visualiser"
        Width="1260" Height="800"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding RequestDeleteCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding NavigateUpCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding NavigateUpCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding NavigateForwardCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RescanCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <!-- Drive Selector & Scan -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Drive:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" />
                    <ComboBox ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              Width="285"
                              Height="32"
                              VerticalContentAlignment="Center"
                              CornerRadius="4"
                              Background="White"
                              Foreground="#111111"
                              BorderBrush="#D1D5DB"
                              IsEnabled="{Binding !IsScanning}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="#111111" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Scan Drive"
                            Command="{Binding StartDriveScanCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            FontWeight="SemiBold"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="14,0" />
                </StackPanel>

                <!-- Folder & Rescan Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Content="Browse..."
                            Click="OnBrowseFolderClicked"
                            IsEnabled="{Binding !IsScanning}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            ToolTip.Tip="Browse and scan a folder" />
                    <Button Content="Rescan"
                            Command="{Binding RescanCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            ToolTip.Tip="Rescan the current drive or folder" />
                </StackPanel>

                <!-- Export Report Button -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="Export Report..."
                            Click="OnExportReportClicked"
                            IsEnabled="{Binding CanExport}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            FontWeight="Medium"
                            ToolTip.Tip="Export an interactive, self-contained HTML storage report" />
                </StackPanel>

                <!-- SpaceMonger Free Space Toggle -->
                <ToggleButton Grid.Column="4"
                              Content="Free Space"
                              IsChecked="{Binding ShowFreeSpace}"
                              Height="32"
                              VerticalContentAlignment="Center"
                              CornerRadius="4"
                              Margin="0,0,16,0"
                              Padding="12,0"
                              ToolTip.Tip="Toggle display of drive free space on/off" />

                <!-- Detail Slider (SpaceMonger clutter control) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Height="32">
                    <TextBlock Text="Detail:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="#374151" />
                    <Slider Minimum="1" Maximum="5"
                            Value="{Binding DetailLevel}"
                            Width="90" Height="20"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Treemap Detail (1=Less Detail / Cleaner, 5=More Detail / Deep)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Network Share Warning Banner -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="12,7"
                IsVisible="{Binding IsNetworkWarningVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#92400E">
                    <Run Text="Network location: '" />
                    <Run Text="{Binding NetworkPathToScan}" FontWeight="SemiBold" />
                    <Run Text="'. Scanning over network links may take longer depending on connection speed. Continue?" />
                </TextBlock>
                <Button Grid.Column="2" Content="Scan Network Share"
                        Command="{Binding ConfirmNetworkScanCommand}"
                        Background="#D97706" Foreground="White" FontWeight="SemiBold"
                        Height="30" VerticalContentAlignment="Center" CornerRadius="4"
                        Padding="12,0" Margin="10,0,6,0" />
                <Button Grid.Column="3" Content="Cancel"
                        Command="{Binding DismissNetworkWarningCommand}"
                        Height="30" VerticalContentAlignment="Center" CornerRadius="4"
                        Padding="10,0" />
            </Grid>
        </Border>

        <!-- Row 2: Navigation Bar (Normal) / Live Scan Status Bar (Scanning) -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Height="42" Padding="10,0">
            <Panel VerticalAlignment="Center">
                <!-- Normal Navigation Bar (Visible when NOT scanning) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding !IsScanning}" VerticalAlignment="Center">
                    <Button Grid.Column="0" Content="◀ Back"
                            Command="{Binding NavigateBackCommand}"
                            IsEnabled="{Binding CanNavigateBack}"
                            Width="88" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="▶ Forward"
                            Command="{Binding NavigateForwardCommand}"
                            IsEnabled="{Binding CanNavigateForward}"
                            Width="88" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="▲ Up"
                            Command="{Binding NavigateUpCommand}"
                            IsEnabled="{Binding CanNavigateUp}"
                            Width="65" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="3" Content="⌂ Home"
                            Command="{Binding NavigateHomeCommand}"
                            IsEnabled="{Binding CanNavigateUp}"
                            Width="70" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,8,0" />

                    <TextBox Grid.Column="4"
                             Text="{Binding CurrentPath, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"
                             CornerRadius="4"
                             Background="White"
                             Foreground="#111111"
                             BorderBrush="#D1D5DB"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="12"
                             Padding="8,0" />
                </Grid>

                <!-- Full-Width Live Scan Status Bar (Visible ONLY when scanning) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsScanning}" VerticalAlignment="Center">
                    <Button Grid.Column="0"
                            Content="Cancel Scan"
                            Command="{Binding CancelScanCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Height="30"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            Margin="0,0,12,0" />

                    <ProgressBar Grid.Column="1"
                                 IsIndeterminate="True"
                                 Width="150" Height="16"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ScanProgressText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,0,10,0" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentScanningDirectory}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Panel>
        </Border>

        <!-- Tab Views: Map, Tree, Top Files, File Types -->
        <TabControl Grid.Row="3"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0"
                    Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Foreground" Value="#4B5563" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Style>
            </TabControl.Styles>

            <!-- 1. Map Tab (SpaceMonger Nested Treemap) -->
            <TabItem Header="🗺️ Map">
                <controls:TreemapCanvas x:Name="CanvasControl"
                                        LayoutRoot="{Binding LayoutRoot}"
                                        SelectedNode="{Binding SelectedNode}">
                    <controls:TreemapCanvas.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="🔍 Drill Down into Group" Command="{Binding DrillDownSelectedCommand}" IsVisible="{Binding CanDrillDownSelected}" />
                            <Separator IsVisible="{Binding CanDrillDownSelected}" />
                            <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                            <MenuItem Header="Open File / Folder" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                            <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                            <Separator />
                            <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                            <Separator />
                            <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                        </ContextMenu>
                    </controls:TreemapCanvas.ContextMenu>
                </controls:TreemapCanvas>
            </TabItem>

            <!-- 2. Tree Tab (RidNacs Style) -->
            <TabItem Header="🌲 Tree">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Directory Hierarchy (Expand folders to inspect subtrees, sorted by size descending)"
                                       VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Percentages:" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                                <RadioButton Content="% of Total" GroupName="TreePercentageGroup"
                                             IsChecked="{Binding TreePercentageRelativeToTotal, Mode=TwoWay}"
                                             FontSize="11" VerticalAlignment="Center" />
                                <RadioButton Content="% of Parent" GroupName="TreePercentageGroup"
                                             IsChecked="{Binding TreePercentageRelativeToParent, Mode=TwoWay}"
                                             FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItem="{Binding SelectedTreeNode}"
                              Background="White"
                              Padding="6,4">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="core:StorageNode" ItemsSource="{Binding SortedChildren}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                    <TextBlock Text="{Binding IconText}" VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#111827" />

                                    <!-- Visual % Bar (WCAG AAA contrast: #0F172A on pastel #93C5FD / #CBD5E1 > 10:1 ratio) -->
                                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Width="100" Height="15" ClipToBounds="True" VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding TreePercentageTooltip}">
                                        <Grid>
                                            <ProgressBar Value="{Binding CurrentTreePercentage}" Minimum="0" Maximum="100"
                                                         Foreground="{Binding ProgressColor}" Background="Transparent" BorderThickness="0" Height="15" />
                                            <TextBlock Text="{Binding FormattedPercentage}"
                                                       FontSize="10" FontWeight="Bold" Foreground="#0F172A"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Size -->
                                    <TextBlock Text="{Binding FormattedDisplaySize}" VerticalAlignment="Center"
                                               FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" />

                                    <!-- Sub-items count -->
                                    <TextBlock Text="{Binding FileCount, StringFormat='({0:N0} files)'}" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#6B7280"
                                               IsVisible="{Binding HasChildren}" />

                                    <!-- Modified -->
                                    <TextBlock Text="{Binding FormattedLastModified, StringFormat='- {0}'}" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show on Map" Command="{Binding ShowSelectedTreeNodeOnMapCommand}" />
                                <Separator />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                                <MenuItem Header="Open File / Folder" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                                <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                                <Separator />
                                <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                                <Separator />
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- 3. Top Files Tab -->
            <TabItem Header="📄 Top Files">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <TextBlock Text="Largest 200 Files (Sorted by size descending. Right-click or double-click to reveal in Explorer)"
                                   FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TopFiles}"
                              SelectedItem="{Binding SelectedTopFile}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              DoubleTapped="OnTopFilesDoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" x:DataType="analysis:TopFileItem" Binding="{Binding Name}" Width="250" />
                            <DataGridTextColumn Header="Size" x:DataType="analysis:TopFileItem" Binding="{Binding FormattedSize}" Width="110" />
                            <DataGridTemplateColumn Header="% of Total" Width="140" SortMemberPath="PercentageOfTotal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:TopFileItem">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="15" Margin="6,2" ClipToBounds="True">
                                            <Grid>
                                                <ProgressBar Value="{Binding PercentageOfTotal}" Minimum="0" Maximum="100"
                                                             Foreground="#FCA5A5" Background="Transparent" BorderThickness="0" Height="15" />
                                                <TextBlock Text="{Binding FormattedPercentage}"
                                                           FontSize="10" FontWeight="Bold" Foreground="#0F172A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Extension" x:DataType="analysis:TopFileItem" Binding="{Binding Extension}" Width="115" />
                            <DataGridTextColumn Header="Folder Path" x:DataType="analysis:TopFileItem" Binding="{Binding FullPath}" Width="*" />
                            <DataGridTextColumn Header="Date Modified" x:DataType="analysis:TopFileItem" Binding="{Binding FormattedModified}" Width="150" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show on Map" Command="{Binding ShowSelectedTopFileOnMapCommand}" />
                                <Separator />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                                <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                                <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                                <Separator />
                                <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                                <Separator />
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 4. File Types Tab -->
            <TabItem Header="📊 File Types">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <TextBlock Text="File Extension &amp; Category Breakdown (Sorted by total storage descending)"
                                   FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FileTypes}"
                              SelectedItem="{Binding SelectedFileType}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Extension" x:DataType="analysis:FileTypeSummary" Binding="{Binding Extension}" Width="120" />
                            <DataGridTextColumn Header="Category" x:DataType="analysis:FileTypeSummary" Binding="{Binding Category}" Width="180" />
                            <DataGridTextColumn Header="Total Size" x:DataType="analysis:FileTypeSummary" Binding="{Binding FormattedTotalSize}" Width="120" />
                            <DataGridTemplateColumn Header="% of Total" Width="160" SortMemberPath="PercentageOfTotal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:FileTypeSummary">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="15" Margin="6,2" ClipToBounds="True">
                                            <Grid>
                                                <ProgressBar Value="{Binding PercentageOfTotal}" Minimum="0" Maximum="100"
                                                             Foreground="#86EFAC" Background="Transparent" BorderThickness="0" Height="15" />
                                                <TextBlock Text="{Binding FormattedPercentage}"
                                                           FontSize="10" FontWeight="Bold" Foreground="#0F172A"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="File Count" x:DataType="analysis:FileTypeSummary" Binding="{Binding FormattedFileCount}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="#1F2937" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SelectionDetailText}"
                           FontSize="12"
                           Foreground="#005FB8"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Delete Confirmation / Protected Warning Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#66000000"
                IsVisible="{Binding IsDeleteConfirmationVisible}">
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="500"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 15 35 #50000000">
                <StackPanel Spacing="14">
                    <!-- Title & Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🛡️" FontSize="22" IsVisible="{Binding IsDeleteBlocked}" VerticalAlignment="Center" />
                        <TextBlock Text="🗑️" FontSize="22" IsVisible="{Binding !IsDeleteBlocked}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PendingDeleteTitle}"
                                   FontWeight="Bold" FontSize="15" Foreground="#111827"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Details Box -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Name:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeleteItemName}" FontWeight="Bold" FontSize="12" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Size:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeleteSize}" FontSize="12" Foreground="#111827" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Path:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeletePath}" FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Warning: Blocked -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10"
                            IsVisible="{Binding IsDeleteBlocked}">
                        <TextBlock Text="{Binding DeleteBlockedReason}"
                                   FontSize="12" Foreground="#991B1B" FontWeight="Medium" TextWrapping="Wrap" />
                    </Border>

                    <!-- Notice: Allowed -->
                    <TextBlock Text="This item will be moved to the Windows Recycle Bin and can be restored if needed."
                               FontSize="12" Foreground="#4B5563" TextWrapping="Wrap"
                               IsVisible="{Binding !IsDeleteBlocked}" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Close"
                                Command="{Binding CancelDeleteCommand}"
                                IsVisible="{Binding IsDeleteBlocked}"
                                Padding="16,6"
                                FontWeight="SemiBold" />

                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteCommand}"
                                IsVisible="{Binding !IsDeleteBlocked}"
                                Padding="14,6" />
                        <Button Content="Move to Recycle Bin"
                                Command="{Binding ConfirmDeleteCommand}"
                                IsVisible="{Binding !IsDeleteBlocked}"
                                Background="#DC2626"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
