<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StorageVisualiser.App.ViewModels"
        xmlns:controls="using:StorageVisualiser.App.Controls"
        xmlns:core="using:StorageVisualiser.Core.Model"
        xmlns:analysis="using:StorageVisualiser.Core.Analysis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1260" d:DesignHeight="800"
        x:Class="StorageVisualiser.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Storage Visualiser"
        Width="1260" Height="800"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        DragDrop.AllowDrop="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding RequestDeleteCommand}" />
        <KeyBinding Gesture="Back" Command="{Binding NavigateUpCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding NavigateUpCommand}" />
        <KeyBinding Gesture="Alt+Left" Command="{Binding NavigateBackCommand}" />
        <KeyBinding Gesture="Alt+Right" Command="{Binding NavigateForwardCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RescanCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                <!-- Drive Selector & Scan -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Drive:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" />
                    <ComboBox ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              Width="285"
                              Height="32"
                              VerticalContentAlignment="Center"
                              CornerRadius="4"
                              Background="White"
                              Foreground="#111111"
                              BorderBrush="#D1D5DB"
                              IsEnabled="{Binding !IsScanning}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Foreground="#111111" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Scan Drive"
                            Command="{Binding StartDriveScanCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            FontWeight="SemiBold"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="14,0" />
                </StackPanel>

                <!-- Folder & Rescan Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button Content="Browse..."
                            Click="OnBrowseFolderClicked"
                            IsEnabled="{Binding !IsScanning}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            ToolTip.Tip="Browse and scan a folder" />
                    <Button Content="Rescan"
                            Command="{Binding RescanCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            ToolTip.Tip="Rescan the current drive or folder" />
                </StackPanel>

                <!-- Export Report Button -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="Export Report..."
                            Click="OnExportReportClicked"
                            IsEnabled="{Binding CanExport}"
                            Height="32"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            FontWeight="Medium"
                            ToolTip.Tip="Export an interactive, self-contained HTML storage report" />
                </StackPanel>

                <!-- SpaceMonger Free Space Toggle -->
                <ToggleButton Grid.Column="4"
                              Content="Free Space"
                              IsChecked="{Binding ShowFreeSpace}"
                              Height="32"
                              VerticalContentAlignment="Center"
                              CornerRadius="4"
                              Margin="0,0,16,0"
                              Padding="12,0"
                              ToolTip.Tip="Toggle display of drive free space on/off" />

                <!-- Detail Slider (SpaceMonger clutter control) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Height="32">
                    <TextBlock Text="Detail:" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="#374151" />
                    <Slider Minimum="1" Maximum="5"
                            Value="{Binding DetailLevel}"
                            Width="90" Height="20"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Treemap Detail (1=Less Detail / Cleaner, 5=More Detail / Deep)" />
                </StackPanel>

                <!-- Settings Button -->
                <Button Grid.Column="6"
                        Content="⚙️ Settings"
                        Command="{Binding OpenSettingsCommand}"
                        Height="32"
                        VerticalContentAlignment="Center"
                        CornerRadius="4"
                        Margin="12,0,0,0"
                        Padding="10,0"
                        FontWeight="Medium"
                        ToolTip.Tip="Preferences, color themes, units, and layout options" />
            </Grid>
        </Border>

        <!-- Network Share Warning Banner -->
        <Border Grid.Row="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="12,7"
                IsVisible="{Binding IsNetworkWarningVisible}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#92400E">
                    <Run Text="Network location: '" />
                    <Run Text="{Binding NetworkPathToScan}" FontWeight="SemiBold" />
                    <Run Text="'. Scanning over network links may take longer depending on connection speed. Continue?" />
                </TextBlock>
                <Button Grid.Column="2" Content="Scan Network Share"
                        Command="{Binding ConfirmNetworkScanCommand}"
                        Background="#D97706" Foreground="White" FontWeight="SemiBold"
                        Height="30" VerticalContentAlignment="Center" CornerRadius="4"
                        Padding="12,0" Margin="10,0,6,0" />
                <Button Grid.Column="3" Content="Cancel"
                        Command="{Binding DismissNetworkWarningCommand}"
                        Height="30" VerticalContentAlignment="Center" CornerRadius="4"
                        Padding="10,0" />
            </Grid>
        </Border>

        <!-- Row 2: Navigation Bar (Normal) / Live Scan Status Bar (Scanning) -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Height="42" Padding="10,0">
            <Panel VerticalAlignment="Center">
                <!-- Normal Navigation Bar (Visible when NOT scanning) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding !IsScanning}" VerticalAlignment="Center">
                    <Button Grid.Column="0" Content="◀ Back"
                            Command="{Binding NavigateBackCommand}"
                            IsEnabled="{Binding CanNavigateBack}"
                            Width="88" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="▶ Forward"
                            Command="{Binding NavigateForwardCommand}"
                            IsEnabled="{Binding CanNavigateForward}"
                            Width="88" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="▲ Up"
                            Command="{Binding NavigateUpCommand}"
                            IsEnabled="{Binding CanNavigateUp}"
                            Width="65" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,6,0" />
                    <Button Grid.Column="3" Content="⌂ Home"
                            Command="{Binding NavigateHomeCommand}"
                            IsEnabled="{Binding CanNavigateUp}"
                            Width="70" Height="30"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="0,0" Margin="0,0,8,0" />

                    <TextBox Grid.Column="4"
                             Text="{Binding CurrentPath, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Height="30"
                             CornerRadius="4"
                             Background="White"
                             Foreground="#111111"
                             BorderBrush="#D1D5DB"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="12"
                             Padding="8,0" />
                </Grid>

                <!-- Full-Width Live Scan Status Bar (Visible ONLY when scanning) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsScanning}" VerticalAlignment="Center">
                    <Button Grid.Column="0"
                            Content="Cancel Scan"
                            Command="{Binding CancelScanCommand}"
                            Background="#DC2626"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Height="30"
                            VerticalContentAlignment="Center"
                            CornerRadius="4"
                            Padding="12,0"
                            Margin="0,0,12,0" />

                    <ProgressBar Grid.Column="1"
                                 IsIndeterminate="True"
                                 Width="150" Height="16"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ScanProgressText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               Margin="0,0,10,0" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding CurrentScanningDirectory}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Panel>
        </Border>

        <!-- Active Filter Indicator Banner -->
        <Border Grid.Row="3"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="0,0,0,1"
                Padding="14,6"
                IsVisible="{Binding HasActiveFilter}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Filtered by:" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveFilterDescription}" FontWeight="SemiBold" FontSize="12" Foreground="#1D4ED8" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2"
                        Content="✕ Clear Filter"
                        Command="{Binding ClearFilterCommand}"
                        Background="#DBEAFE"
                        Foreground="#1E40AF"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        Padding="10,3"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CornerRadius="4"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Tab Views: Map, Tree, Top Files, File Types -->
        <TabControl Grid.Row="4"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="0"
                    Padding="0">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Foreground" Value="#4B5563" />
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Style>
            </TabControl.Styles>

            <!-- 1. Map Tab (Nested Treemap) -->
            <TabItem Header="🗺️ Map">
                <Grid RowDefinitions="Auto,*">
                    <!-- Color Legend Strip (Visible in File Type and File Age color modes) -->
                    <Border Grid.Row="0"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1"
                            Padding="12,5"
                            IsVisible="{Binding IsLegendVisible}">
                        <ItemsControl ItemsSource="{Binding CurrentLegendItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,16,2" VerticalAlignment="Center">
                                        <Border Width="13" Height="13"
                                                CornerRadius="2"
                                                Background="{Binding ColorHex}"
                                                BorderBrush="#9CA3AF"
                                                BorderThickness="1" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#374151" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <controls:TreemapCanvas Grid.Row="1"
                                            x:Name="CanvasControl"
                                            LayoutRoot="{Binding LayoutRoot}"
                                            SelectedNode="{Binding SelectedNode}"
                                            ColorMode="{Binding ColorMode}"
                                            ColorBlindSafe="{Binding ColorBlindSafe}">
                        <controls:TreemapCanvas.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 Drill Down into Group" Command="{Binding DrillDownSelectedCommand}" IsVisible="{Binding CanDrillDownSelected}" />
                                <Separator IsVisible="{Binding CanDrillDownSelected}" />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                                <MenuItem Header="Open File / Folder" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                                <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                                <Separator />
                                <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                                <Separator />
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                            </ContextMenu>
                        </controls:TreemapCanvas.ContextMenu>
                    </controls:TreemapCanvas>
                </Grid>
            </TabItem>

            <!-- 2. Tree Tab (RidNacs Style) -->
            <TabItem Header="🌲 Tree">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Directory Hierarchy (Expand folders to inspect subtrees, sorted by size descending)"
                                       VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Percentages:" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280" />
                                <RadioButton Content="% of Total" GroupName="TreePercentageGroup"
                                             IsChecked="{Binding TreePercentageRelativeToTotal, Mode=TwoWay}"
                                             FontSize="11" VerticalAlignment="Center" />
                                <RadioButton Content="% of Parent" GroupName="TreePercentageGroup"
                                             IsChecked="{Binding TreePercentageRelativeToParent, Mode=TwoWay}"
                                             FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItem="{Binding SelectedTreeNode}"
                              Background="White"
                              Padding="6,4">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="core:StorageNode" ItemsSource="{Binding SortedChildren}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                    <TextBlock Text="{Binding IconText}" VerticalAlignment="Center" FontSize="13" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#111827" />

                                    <!-- Visual % Bar (WCAG AAA contrast: #0F172A on pastel #93C5FD / #CBD5E1 > 10:1 ratio) -->
                                    <controls:PercentageBar Value="{Binding CurrentTreePercentage}"
                                                            Text="{Binding FormattedPercentage}"
                                                            FillBrush="{Binding ProgressColor}"
                                                            Width="135" Height="16"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding TreePercentageTooltip}" />

                                    <!-- Size -->
                                    <TextBlock Text="{Binding FormattedDisplaySize}" VerticalAlignment="Center"
                                               FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" />

                                    <!-- Sub-items count -->
                                    <TextBlock Text="{Binding FileCount, StringFormat='({0:N0} files)'}" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#6B7280"
                                               IsVisible="{Binding HasChildren}" />

                                    <!-- Modified -->
                                    <TextBlock Text="{Binding FormattedLastModified, StringFormat='- {0}'}" VerticalAlignment="Center"
                                               FontSize="11" Foreground="#9CA3AF" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show on Map" Command="{Binding ShowSelectedTreeNodeOnMapCommand}" />
                                <Separator />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                                <MenuItem Header="Open File / Folder" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                                <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                                <Separator />
                                <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                                <Separator />
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </TabItem>

            <!-- 3. Top Files Tab -->
            <TabItem Header="📄 Top Files">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <TextBlock Text="Largest 200 Files (Sorted by size descending. Right-click or double-click to reveal in Explorer)"
                                   FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TopFiles}"
                              SelectedItem="{Binding SelectedTopFile}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              DoubleTapped="OnTopFilesDoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" x:DataType="analysis:TopFileItem" Binding="{Binding Name}" Width="250" />
                            <DataGridTextColumn Header="Size" x:DataType="analysis:TopFileItem" Binding="{Binding FormattedSize}" Width="110" />
                            <DataGridTemplateColumn Header="% of Total" Width="150" SortMemberPath="PercentageOfTotal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:TopFileItem">
                                        <controls:PercentageBar Value="{Binding PercentageOfTotal}"
                                                                Text="{Binding FormattedPercentage}"
                                                                FillBrush="#FCA5A5"
                                                                Height="16" Margin="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Extension" x:DataType="analysis:TopFileItem" Binding="{Binding Extension}" Width="115" />
                            <DataGridTextColumn Header="Folder Path" x:DataType="analysis:TopFileItem" Binding="{Binding FullPath}" Width="*" />
                            <DataGridTemplateColumn Header="Date Modified" Width="180" SortMemberPath="LastModified">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:TopFileItem">
                                        <TextBlock Text="{Binding FormattedModified}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,20,0"
                                                   Foreground="#4B5563" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show on Map" Command="{Binding ShowSelectedTopFileOnMapCommand}" />
                                <Separator />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" IsEnabled="{Binding CanOpenInExplorer}" />
                                <MenuItem Header="Open File" Command="{Binding OpenFileCommand}" IsEnabled="{Binding CanOpenFile}" />
                                <MenuItem Header="Copy Full Path" Click="OnCopyPathClicked" IsEnabled="{Binding CanCopyPath}" />
                                <Separator />
                                <MenuItem Header="Delete to Recycle Bin..." Command="{Binding RequestDeleteCommand}" IsEnabled="{Binding CanDelete}" InputGesture="Delete" />
                                <Separator />
                                <MenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 4. File Types Tab -->
            <TabItem Header="📊 File Types">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,6">
                        <TextBlock Text="File Extension &amp; Category Breakdown (Sorted by total storage descending. Right-click or double-click to filter)"
                                   FontSize="12" Foreground="#4B5563" FontWeight="Medium" />
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FileTypes}"
                              SelectedItem="{Binding SelectedFileType}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              DoubleTapped="OnFileTypeDoubleTapped">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Extension" x:DataType="analysis:FileTypeSummary" Binding="{Binding Extension}" Width="120" />
                            <DataGridTextColumn Header="Category" x:DataType="analysis:FileTypeSummary" Binding="{Binding Category}" Width="180" />
                            <DataGridTextColumn Header="Total Size" x:DataType="analysis:FileTypeSummary" Binding="{Binding FormattedTotalSize}" Width="120" />
                            <DataGridTemplateColumn Header="% of Total" Width="160" SortMemberPath="PercentageOfTotal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:FileTypeSummary">
                                        <controls:PercentageBar Value="{Binding PercentageOfTotal}"
                                                                Text="{Binding FormattedPercentage}"
                                                                FillBrush="#86EFAC"
                                                                Height="16" Margin="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="File Count" Width="140" SortMemberPath="FileCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="analysis:FileTypeSummary">
                                        <TextBlock Text="{Binding FormattedFileCount}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,16,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Filter Map &amp; Tree by this Type" Command="{Binding FilterBySelectedFileTypeCommand}" />
                                <MenuItem Header="Filter Tree by this Type" Command="{Binding FilterTreeBySelectedFileTypeCommand}" />
                                <MenuItem Header="Show Top Files for this Type" Command="{Binding ShowTopFilesForSelectedFileTypeCommand}" />
                                <Separator IsVisible="{Binding HasActiveFilter}" />
                                <MenuItem Header="Clear Filter" Command="{Binding ClearFilterCommand}" IsVisible="{Binding HasActiveFilter}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="#E5E7EB" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="#1F2937" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SelectionDetailText}"
                           FontSize="12"
                           Foreground="#005FB8"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Delete Confirmation / Protected Warning Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="#66000000"
                IsVisible="{Binding IsDeleteConfirmationVisible}">
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="500"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 15 35 #50000000">
                <StackPanel Spacing="14">
                    <!-- Title & Icon -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🛡️" FontSize="22" IsVisible="{Binding IsDeleteBlocked}" VerticalAlignment="Center" />
                        <TextBlock Text="🗑️" FontSize="22" IsVisible="{Binding !IsDeleteBlocked}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PendingDeleteTitle}"
                                   FontWeight="Bold" FontSize="15" Foreground="#111827"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Details Box -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Name:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeleteItemName}" FontWeight="Bold" FontSize="12" Foreground="#111827" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Size:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeleteSize}" FontSize="12" Foreground="#111827" />
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Grid.Column="0" Text="Path:" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" />
                                <TextBlock Grid.Column="1" Text="{Binding PendingDeletePath}" FontSize="11" Foreground="#4B5563" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Warning: Blocked -->
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="10"
                            IsVisible="{Binding IsDeleteBlocked}">
                        <TextBlock Text="{Binding DeleteBlockedReason}"
                                   FontSize="12" Foreground="#991B1B" FontWeight="Medium" TextWrapping="Wrap" />
                    </Border>

                    <!-- Notice: Allowed -->
                    <TextBlock Text="This item will be moved to the Windows Recycle Bin and can be restored if needed."
                               FontSize="12" Foreground="#4B5563" TextWrapping="Wrap"
                               IsVisible="{Binding !IsDeleteBlocked}" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Close"
                                Command="{Binding CancelDeleteCommand}"
                                IsVisible="{Binding IsDeleteBlocked}"
                                Padding="16,6"
                                FontWeight="SemiBold" />

                        <Button Content="Cancel"
                                Command="{Binding CancelDeleteCommand}"
                                IsVisible="{Binding !IsDeleteBlocked}"
                                Padding="14,6" />
                        <Button Content="Move to Recycle Bin"
                                Command="{Binding ConfirmDeleteCommand}"
                                IsVisible="{Binding !IsDeleteBlocked}"
                                Background="#DC2626"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="16,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Settings Modal Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="#66000000"
                IsVisible="{Binding IsSettingsVisible}">
            <Border Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="560"
                    MaxHeight="680"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 15 35 #50000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Title Bar -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚙️" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock Text="Settings &amp; Preferences" FontWeight="Bold" FontSize="16" Foreground="#111827" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseSettingsCommand}" Background="Transparent" Foreground="#6B7280" BorderThickness="0" Padding="8,4" FontSize="14" />
                    </Grid>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="500" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="0,0,8,0">

                            <!-- Section 1: Appearance & Colors -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Appearance &amp; Colors" FontWeight="Bold" FontSize="13" Foreground="#1F2937" />

                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Grid.Column="0" Text="Treemap Color Mode:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableColorModes}"
                                                  SelectedItem="{Binding SelectedColorModeOption}"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  Background="White"
                                                  Foreground="#111111"
                                                  BorderBrush="#D1D5DB">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#111111" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding SettingsColorBlindSafe}" Margin="0,4,0,0">
                                        <TextBlock Text="Use high-contrast, color-blind safe palettes (Okabe-Ito / Tol)" FontSize="12" Foreground="#374151" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Units & Sizing Metric -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Units &amp; Size Calculation" FontWeight="Bold" FontSize="13" Foreground="#1F2937" />

                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Grid.Column="0" Text="Size Unit System:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableUnitSystems}"
                                                  SelectedItem="{Binding SelectedUnitSystemOption}"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  Background="White"
                                                  Foreground="#111111"
                                                  BorderBrush="#D1D5DB">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#111111" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding SettingsUseAllocatedSize}" Margin="0,4,0,0">
                                        <TextBlock Text="Use allocated size on disk instead of logical file size" FontSize="12" Foreground="#374151" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Treemap & Layout -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Treemap Layout &amp; Tree View" FontWeight="Bold" FontSize="13" Foreground="#1F2937" />

                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Grid.Column="0" Text="Layout Aspect Bias:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableLayoutBiases}"
                                                  SelectedItem="{Binding SelectedLayoutBiasOption}"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="4"
                                                  Background="White"
                                                  Foreground="#111111"
                                                  BorderBrush="#D1D5DB">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#111111" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="150,*,40">
                                        <TextBlock Grid.Column="0" Text="Default Detail Level:" VerticalAlignment="Center" FontSize="12" Foreground="#4B5563" />
                                        <Slider Grid.Column="1" Minimum="1" Maximum="5" Value="{Binding SettingsDetailLevel}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding SettingsDetailLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#374151" />
                                    </Grid>

                                    <CheckBox IsChecked="{Binding SettingsShowFreeSpace}">
                                        <TextBlock Text="Show drive free space block on map" FontSize="12" Foreground="#374151" />
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding SettingsTreePercentageRelativeToTotal}">
                                        <TextBlock Text="Scale tree % bars relative to Total scanned (uncheck for % of Parent)" FontSize="12" Foreground="#374151" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: File Actions & Safety -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="File Actions &amp; Safety" FontWeight="Bold" FontSize="13" Foreground="#1F2937" />

                                    <CheckBox IsChecked="{Binding SettingsConfirmBeforeDelete}">
                                        <TextBlock Text="Prompt for confirmation before moving items to Recycle Bin" FontSize="12" Foreground="#374151" />
                                    </CheckBox>

                                    <CheckBox IsChecked="{Binding SettingsAutoRescanAfterDelete}">
                                        <TextBlock Text="Automatically rescan location after Recycle Bin deletion" FontSize="12" Foreground="#374151" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Buttons -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
                        <Button Grid.Column="0"
                                Content="Reset to Defaults"
                                Command="{Binding ResetSettingsToDefaultsCommand}"
                                Padding="12,6"
                                Foreground="#4B5563" />

                        <Button Grid.Column="2"
                                Content="Cancel"
                                Command="{Binding CloseSettingsCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />

                        <Button Grid.Column="3"
                                Content="Save &amp; Apply"
                                Command="{Binding SaveSettingsCommand}"
                                Background="#0078D4"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="16,6" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
